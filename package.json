{
  "name": "trading-company-frontend",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:integration": "node --test tests/backend.integration.js",
    "test:ui": "node --import ./tests/register.mjs --test tests/ui.test.jsx",
    "test:dev": "node --test tests/dev.system.js"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
